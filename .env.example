# Telegram (optional — without these, the in-app channel preview is the public surface)
# Create a channel, add the bot as admin (post + edit), then set:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Optional gate for the private admin / ingest APIs
ADMIN_KEY=

# Distribution — this engine accepts and pays out one coin only.
# Leave CALLOUT_MINT empty for idle / waiting. Paste the launch mint in /ops.
CALLOUT_TOKEN=SHILL
CALLOUT_MINT=
CALLOUT_NAME=SHILL
# Per recipient, per snapshot. 2_500_000 = 0.25% of the standard 1B Pump supply.
ALLOCATION_AMOUNT=2500000
DISTRIBUTION_TOKEN=SHILL
SNAPSHOT_MIN_MS=300000
SNAPSHOT_MAX_MS=900000
STARTUP_SNAPSHOT_DELAY_MS=12000
DEMO_FAST_START=false
DEMO_FEED=false
PUMP_INGEST=true
PUMP_CALLOUT_POLL_MS=1000

# Axiom mint-scoped callouts (requires logged-in browser Cookie header)
# Copy from DevTools → Network → callouts request → Cookie
AXIOM_INGEST=true
AXIOM_CALLOUT_POLL_MS=1000
AXIOM_COOKIE=

# FOMO app feed via unmetered WebSocket (same theses as in-app FOMO). Never use /v2/thesis REST.
FOMO_INGEST=true
FOMO_THESIS_POLL_MS=20000
FOMO_API_KEY=
# Paid wallet resolve is 2,500 credits — keep false until you top up. Use FOMO_WALLET_MAP / Redis.
FOMO_PAID_WALLET_RESOLVE=false
FOMO_WALLET_MAP=

# FOMO Family scrape — local only: node --env-file=.env.local scripts/watch-fomo-family.mjs
# Auth + trades URL from DevTools on prod-api.fomo.family (never commit).
FOMO_FAMILY_COOKIE=
FOMO_FAMILY_AUTHORIZATION=
FOMO_FAMILY_TRADES_URL=
FOMO_FAMILY_TRADE_IDS=
FOMO_FAMILY_USER_URL_TEMPLATE=https://prod-api.fomo.family/users/{userId}
FOMO_FAMILY_POLL_MS=15000
FOMO_WATCH_MINT=



# Bond lottery — remaining dev-wallet supply, split between the drawn winners
MIGRATION_BONUS_AMOUNT=10000000
MIGRATION_MIN_CALLOUTS=2
MIGRATION_POLL_MS=15000

# Treasury identity. Prefer TREASURY_PRIVATE_KEY (base58 seed or 64-byte keypair).
# When set, payouts are real on-chain SPL/SOL transfers (fund the wallet + ATA first).
# Without a key, the engine uses mock signatures for demos.
# The public address is derived from the key when set. Never commit real keys.
TREASURY_PRIVATE_KEY=
TREASURY_PUBLIC_ADDRESS=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
EXPLORER_TX_URL=https://solscan.io/tx/{signature}
EXPLORER_ADDRESS_URL=https://solscan.io/account/{address}

# Durable watch ledger (rounds + lifetime bonding callers). Required on Vercel so
# snapshot history and ≥2-callout bonding eligibility survive cold starts.
# Create an Upstash Redis DB (or Vercel KV) and paste the REST credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public website links (optional — hide when empty)
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_X_URL=
