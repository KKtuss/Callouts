# Telegram (optional — without these, the in-app channel preview is the public surface)
# Create a channel, add the bot as admin (post + edit), then set:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Optional gate for the private admin / ingest APIs
ADMIN_KEY=

# Distribution — this engine accepts and pays out one coin only
CALLOUT_TOKEN=AIDEN
CALLOUT_MINT=4i5FqkfYDAPcEVcXyuVyaaBcz3bpwJPqDkmaF36kpump
CALLOUT_NAME=The Day Trader
# Per recipient, per snapshot. 2_500_000 = 0.25% of the standard 1B Pump supply.
ALLOCATION_AMOUNT=2500000
DISTRIBUTION_TOKEN=AIDEN
SNAPSHOT_MIN_MS=300000
SNAPSHOT_MAX_MS=900000
STARTUP_SNAPSHOT_DELAY_MS=12000
DEMO_FAST_START=false
DEMO_FEED=false
PUMP_INGEST=true
PUMP_CALLOUT_POLL_MS=4000

# Axiom mint-scoped callouts (requires logged-in browser Cookie header)
# Copy from DevTools → Network → callouts request → Cookie
AXIOM_INGEST=true
AXIOM_CALLOUT_POLL_MS=4000
AXIOM_COOKIE=

# Bond lottery — remaining dev-wallet supply, split between the drawn winners
MIGRATION_BONUS_AMOUNT=10000000
MIGRATION_MIN_CALLOUTS=2
MIGRATION_POLL_MS=15000
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Treasury identity. Prefer TREASURY_PRIVATE_KEY (base58 seed or 64-byte keypair).
# The public address is derived from the key when set. Never commit real keys.
TREASURY_PRIVATE_KEY=
TREASURY_PUBLIC_ADDRESS=
EXPLORER_TX_URL=https://solscan.io/tx/{signature}
EXPLORER_ADDRESS_URL=https://solscan.io/account/{address}

# Public website links (optional — hide when empty)
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_X_URL=
